# ── 铸剑炉 (Forge) 环境变量模板 ─────────────────────────
# 复制本文件为 .env 并填写实际值; .env 已被 .gitignore 排除, 永不入库。

# ── LLM 提供商 (DeepSeek OpenAI 兼容) ──
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODEL_FLASH=deepseek-flash
DEEPSEEK_MODEL_PRO=deepseek-flash
DEEPSEEK_MODEL_VISION=deepseek-flash
DEEPSEEK_ROUTER=auto
DEEPSEEK_REASONING_EFFORT=high

# ── 通用 LLM 参数 ──
LLM_API_KEY=
LLM_MAX_TOKENS=131072
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_REQUEST_TIMEOUT=120s
LLM_STREAM_TIMEOUT=300s

# ── 铸剑炉运行参数 ──
FORGE_WORK_DIR=D:\\forge
FORGE_TOOL_TIMEOUT=120
FORGE_MAX_CODE_SIZE=262144
FORGE_MAX_OUTPUT=8192
FORGE_MAX_CONCURRENT=4
FORGE_CACHE_SIZE=200
FORGE_RETRY_MAX=3
FORGE_RETRY_BACKOFF=2s
FORGE_PLUGIN_RELEASE_DIR=D:\\forge_release

# ── Gate 与功能开关 ──
# FORGE_GATES_ENABLED=python,go,sh,node,math,logic,regex,knowledge,chain,self,tcm,browser
FORGE_GATES_ENABLED=
FORGE_GATE_AUDIT=1
FORGE_ANCHOR_GUARD=1
FORGE_NO_EMOJI=0
FORGE_NO_READLINE=0
FORGE_SHOW_REASONING=0
FORGE_DEBUG_REQ=0
FORGE_SYNC_MEMORY=1
FORGE_SMOKE=0
FORGE_E2E=0
