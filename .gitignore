# 铸剑炉 .gitignore

# Binaries
forge.exe
铸剑炉.exe
*.exe

# Environment (contains API keys)
.env

# Backup files
*.bak
*.bak_*
*.old
*.old*
*.v2.bak
*.pre_ping_bak

# Go build artifacts
*.o
*.a
*.test
*.out

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Temp / test output
_test_*/
_*/
*.tmp
test_out*.txt
test_full*.txt
test_result*.txt

# Forge internal (runtime, not source)
.forge/history
.forge/test_*
.forge/memory/

# Large files
*.tar.xz
rust.tar.xz

# Dependencies in-tree (go/ is toolchain, deno/ is runtime)
go/go/
deno/

# Python cache
__pycache__/
*.pyc


# 铸剑炉守门人补充 (2026-08-01)
